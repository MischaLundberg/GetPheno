# Copy to .env.docker and replace every value for the Unix user running this instance.
GETPHENO_UID=1000
GETPHENO_GID=1000
GETPHENO_ACCESS_GID=1000
GETPHENO_UNIX_USER=your_unix_login
GETPHENO_PORT=3838
GETPHENO_IMAGE=ghcr.io/mischalundberg/getpheno:latest

# Absolute paths are mounted at the identical path inside the container because
# projects.conf and submitted Slurm scripts use cluster-visible absolute paths.
GETPHENO_PROJECTS_CONFIG=/absolute/path/to/projects.conf
GETPHENO_PREPROCESSED_ROOT=/data/preprocessed
GETPHENO_SHARED_ROOT=/dprhdbds/shared
GETPHENO_SERVICES_ROOT=/services/tools
GETPHENO_SLURM_CONF_DIR=/etc/slurm
GETPHENO_MUNGE_DIR=/run/munge
